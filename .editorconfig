root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,json,mjs,yaml,yml}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[scripts/install.ps1]
# Windows PowerShell 5.1 otherwise decodes Chinese text with the ANSI code page.
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false
