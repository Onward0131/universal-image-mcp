  "bundleDependencies": [
    "@modelcontextprotocol/sdk",
    "zod"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onward0131/universal-image-mcp.git"
  },
  "homepage": "https://github.com/Onward0131/universal-image-mcp#readme",
