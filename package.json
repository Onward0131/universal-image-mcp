{
  "name": "wawapi-image-mcp",
  "version": "1.3.0",
  "private": true,
  "description": "Text-only stdio MCP server and Codex Skill for image generation through Wawapi",
  "license": "MIT",
  "keywords": [
    "codex",
    "image-generation",
    "mcp",
    "model-context-protocol",
    "openai-compatible",
    "skill",
    "stdio",
    "text-only",
    "wawapi"
  ],
  "main": "lib/bridge.js",
  "files": [
    "bin/wawapi-image-mcp.mjs",
    "lib/bridge.js",
    "lib/capabilities.js",
    "lib/mcp-config.js",
    "lib/image-api.js",
    "lib/model-catalog.js",
    "lib/storage.js",
    "resources/capabilities.json",
    "skills/wawapi-image/",
    "scripts/mcp-doctor.mjs",
    "CAPABILITIES.en.md",
    "CAPABILITIES.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.en.md",
    "README.md"
  ],
  "bin": {
    "wawapi-image-mcp": "bin/wawapi-image-mcp.mjs"
  },
  "scripts": {
