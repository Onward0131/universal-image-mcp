{
  "name": "universal-image-mcp",
  "version": "2.0.0",
  "private": true,
  "description": "Configurable multi-provider image generation and editing MCP for Codex",
  "license": "MIT",
  "keywords": [
    "codex",
    "image-generation",
    "mcp",
    "model-context-protocol",
    "openai-compatible",
    "skill",
    "stdio",
    "text-only",
    "gemini",
    "openrouter"
  ],
  "main": "lib/bridge.js",
  "files": [
    "bin/universal-image-mcp.mjs",
    "lib/bridge.js",
    "lib/capabilities.js",
    "lib/mcp-config.js",
    "lib/image-api.js",
    "lib/provider-protocol.js",
    "lib/model-catalog.js",
    "lib/storage.js",
    "skills/universal-image/",
    "scripts/mcp-doctor.mjs",
    "scripts/check-config.mjs",
    "CAPABILITIES.en.md",
    "CAPABILITIES.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.en.md",
    "README.md",
    "docs/PROVIDERS.md",
    "docs/ASSESSMENT.md",
    "examples/",
    "docs/LIVE-TEST.md"
  ],
  "bin": {
    "universal-image-mcp": "bin/universal-image-mcp.mjs"
  },
  "scripts": {
    "test": "node --test",
    "verify:installed": "node scripts/mcp-doctor.mjs",
    "verify:live": "node scripts/live-mcp-smoke.mjs",
