    "build:release": "pwsh -NoLogo -NoProfile -File scripts/build-release.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
